.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
._*
Thumbs.db

# Mount artifacts
Users/

# Logs
logs/
*.log

# PageIndex cache
.pageindex/

# Benchmark cache
benchmark/_cache/frontend/dist/

# Tooling artifacts (committed by accident in past as untracked)
node_modules/
test-results/

# Agent session metadata (settings, worktrees, hook output)
/.claude/
